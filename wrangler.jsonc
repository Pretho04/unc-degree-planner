// Cloudflare Worker config. Deploy with: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unc-degree-planner",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // public/ is served as-is; requests that don't match a file (the /api/* routes) go to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true }
}
